      "item": [
        {
          "id": "02081990-ae3e-4e2a-ac74-4ae2b2348764",
          "name": "PagerDuty List notifications",
          "request": {
            "name": "PagerDuty List notifications",
            "description": {
              "content": "List notifications for a given time range, optionally filtered by type (sms_notification, email_notification, phone_notification, or push_notification).\n\nA Notification is created when an Incident is triggered or escalated.\n\nFor more information see the [API Concepts Document](../../api-reference/ZG9jOjI3NDc5Nzc-api-concepts#notifications)\n\nScoped OAuth requires: `users:notifications.read`\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "notifications"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "The number of results per page."
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Offset to start pagination search results."
                },
                {
                  "disabled": false,
                  "key": "total",
                  "value": "false",
                  "description": "By default the `total` field in pagination responses is set to `null` to provide the fastest possible response times. Set `total` to `true` for this field to be populated.\n\nSee our [Pagination Docs](https://developer.pagerduty.com/docs/rest-api-v2/pagination/) for more information.\n"
                },
                {
                  "disabled": false,
                  "key": "time_zone",
                  "value": "<tzinfo>",
                  "description": "Time zone in which results will be rendered. This will default to the account time zone."
                },
                {
                  "disabled": false,
                  "key": "since",
                  "value": "<dateTime>",
                  "description": "(Required) The start of the date range over which you want to search. The time element is optional."
                },
                {
                  "disabled": false,
                  "key": "until",
                  "value": "<dateTime>",
                  "description": "(Required) The end of the date range over which you want to search. This should be in the same format as since. The size of the date range must be less than 3 months."
                },
                {
                  "disabled": false,
                  "key": "filter",
                  "value": "<string>",
                  "description": "Return notification of this type only."
                },
                {
                  "disabled": false,
                  "key": "include[]",
                  "value": "<string>",
                  "description": "Array of additional details to include."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
